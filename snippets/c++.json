{
  "Cout to console": {
    "prefix": "cout",
    "body": [
      "std::cout << std::format(\"$1 {}\", $2) << std::endl;",
      "$0"
    ],
    "description": "Output to console with std::cout"
  },
  "Cin from console": {
    "prefix": "cin",
    "body": [
      "std::cin >> $1;",
      "$0"
    ],
    "description": "Input from console with std::cin"
  },
  "Endl to a console": {
    "prefix": "endl",
    "body": [
      "std::cout << std::endl;",
      "$0"
    ],
    "description": "Writes endl line"
  },
  "Println to console": {
    "prefix": "println",
    "body": [
      "std::println(\"${1:text} {}\", $2);",
