  "Class Rule of Five": {
    "prefix": "class5",
    "body": [
      "class ${1:ClassName} {",
      "public:",
      "    explicit $1(${2});",
      "    ~$1();",
      "",
      "    $1(const $1&)            = ${3|default,delete|};",
      "    $1& operator= (const $1&) = $3;",
      "    $1($1&&) noexcept            = ${4|default,delete|};",
      "    $1& operator= ($1&&) noexcept = $4;",
      "",
      "private:",
      "    $0",
      "};"
    ],
    "description": "Class with explicit copy/move constructors and assignments (rule of five)"
  },
